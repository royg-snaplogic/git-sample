                    }
                },
                "settings": {
                    "executable_during_suggest": {
                        "value": false
                    },
                    "maxRetryProp": {
                        "expression": false,
                        "value": 0
                    },
                    "passThrough": {
                        "value": true
                    },
                    "queryType": {
                        "expression": false,
                        "value": "Write"
                    },
                    "retryIntervalProp": {
                        "expression": false,
                        "value": 1
                    },
                    "sessionParamsProp": {
                        "value": []
                    },
                    "sqlQueryManagement": {
                        "value": "Continue to execute queued queries when pipeline is stopped or if it fails"
                    },
                    "sqlStatement": {
                        "expression": true,
                        "value": "\"UPDATE \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot SET business_key = \" + (lib.cfg.keyExpr(_keyColumns)) + \", row_hash = sha2(payload, 256) WHERE run_id = \" + (lib.cfg.sqlStr(_runId))"
                    }
                }
            }
        },
        "11111111-1111-1111-1111-000000000002": {
            "class_id": "com-snaplogic-snaps-databricks-execute",
            "class_version": 1,
            "instance_id": "11111111-1111-1111-1111-000000000002",
            "property_map": {
                "account": {
                    "account_ref": {
                        "value": {
                            "label": {
                                "expression": false,
                                "label": "../../shared/Databricks_EMEA-SE_sql-warehouse-SERVERLESS",
                                "value": "Databricks_EMEA-SE_sql-warehouse-SERVERLESS"
                            },
                            "ref_class_id": {
                                "value": "com-snaplogic-snap-api-sql-accounts-databricks-databricksdatabaseaccount"
                            },
                            "ref_id": {
                                "expression": false,
                                "value": null
                            }
                        }
                    }
                },
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
                        "value": "fail"
                    }
                },
                "info": {
                    "label": {
                        "value": "Completeness and delete-guard counts"
                    },
                    "notes": {
                        "value": null
                    }
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "executable_during_suggest": {
                        "value": false
                    },
                    "maxRetryProp": {
                        "expression": false,
                        "value": 0
                    },
                    "passThrough": {
                        "value": true
                    },
                    "queryType": {
                        "expression": false,
                        "value": "Read"
                    },
                    "retryIntervalProp": {
                        "expression": false,
                        "value": 1
                    },
                    "sessionParamsProp": {
                        "value": []
                    },
                    "sqlQueryManagement": {
                        "value": "Continue to execute queued queries when pipeline is stopped or if it fails"
                    },
                    "sqlStatement": {
                        "expression": true,
                        "value": "\"SELECT (SELECT count(*) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \") AS staged_rows, (SELECT count(DISTINCT business_key) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \") AS distinct_keys, (SELECT count(*) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = \" + (lib.cfg.sqlStr(_objectName)) + \" AND NOT is_deleted) AS active_rows, (SELECT count(*) FROM (SELECT business_key FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = \" + (lib.cfg.sqlStr(_objectName)) + \" AND NOT is_deleted) t LEFT ANTI JOIN (SELECT business_key FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \") s ON t.business_key = s.business_key) AS would_delete\""
                    }
                }
            }
        },
        "11111111-1111-1111-1111-000000000003": {
            "class_id": "com-snaplogic-snaps-transform-datatransform",
            "class_version": 4,
            "instance_id": "11111111-1111-1111-1111-000000000003",
            "property_map": {
                "account": {
                    "account_ref": {
                        "value": {}
                    }
                },
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
                        "value": "fail"
                    }
                },
                "info": {
                    "label": {
                        "value": "Evaluate completeness and guard"
                    },
                    "notes": {
                        "value": null
                    }
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "nullSafeAccess": {
                        "value": false
                    },
                    "omitExpressionIfMissing": {
                        "value": false
                    },
                    "passThrough": {
                        "value": true
                    },
                    "transformations": {
                        "value": {
                            "mappingRoot": {
                                "value": "$"
                            },
                            "mappingTable": {
                                "value": [
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "parseInt(_expectedTotal)"
                                        },
                                        "targetPath": {
                                            "value": "$expected"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "parseInt(_expectedTotal) >= 0 && $staged_rows == parseInt(_expectedTotal)"
                                        },
                                        "targetPath": {
                                            "value": "$complete"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$would_delete <= (_deleteGuardMax == '' ? lib.cfg.deleteGuardMax : parseInt(_deleteGuardMax)) && ($active_rows == 0 || $would_delete * 100 <= (_deleteGuardPct == '' ? lib.cfg.deleteGuardPct : parseFloat(_deleteGuardPct)) * $active_rows)"
                                        },
                                        "targetPath": {
                                            "value": "$within_guard"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        "11111111-1111-1111-1111-000000000004": {
            "class_id": "com-snaplogic-snaps-transform-datatransform",
            "class_version": 4,
            "instance_id": "11111111-1111-1111-1111-000000000004",
            "property_map": {
                "account": {
                    "account_ref": {
                        "value": {}
                    }
                },
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
                        "value": "fail"
                    }
                },
                "info": {
                    "label": {
                        "value": "Decide deletes and status"
                    },
                    "notes": {
                        "value": null
                    }
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "nullSafeAccess": {
                        "value": false
                    },
                    "omitExpressionIfMissing": {
                        "value": false
                    },
                    "passThrough": {
                        "value": true
                    },
                    "transformations": {
                        "value": {
                            "mappingRoot": {
                                "value": "$"
                            },
                            "mappingTable": {
                                "value": [
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$complete && ($within_guard || _forceDeletes == 'true')"
                                        },
                                        "targetPath": {
                                            "value": "$allow"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "!$complete ? 'OK_DELETES_DEFERRED_INCOMPLETE' : (($within_guard || _forceDeletes == 'true') ? 'OK' : 'OK_DELETES_BLOCKED_GUARD')"
                                        },
                                        "targetPath": {
                                            "value": "$status"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "'expected=' + $expected + ' staged=' + $staged_rows + ' distinct_keys=' + $distinct_keys + ' active=' + $active_rows + ' would_delete=' + $would_delete + ($distinct_keys != $staged_rows ? ' WARNING duplicate business keys - check keyColumns' : '')"
                                        },
                                        "targetPath": {
                                            "value": "$message"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        "11111111-1111-1111-1111-000000000005": {
            "class_id": "com-snaplogic-snaps-databricks-multiexecute",
            "class_version": 1,
            "instance_id": "11111111-1111-1111-1111-000000000005",
            "property_map": {
                "account": {
                    "account_ref": {
                        "value": {
                            "label": {
                                "expression": false,
                                "label": "../../shared/Databricks_EMEA-SE_sql-warehouse-SERVERLESS",
                                "value": "Databricks_EMEA-SE_sql-warehouse-SERVERLESS"
                            },
                            "ref_class_id": {
                                "value": "com-snaplogic-snap-api-sql-accounts-databricks-databricksdatabaseaccount"
                            },
                            "ref_id": {
                                "expression": false,
                                "value": null
                            }
                        }
                    }
                },
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    },
                    "error_behavior": {
                        "value": "fail"
                    }
                },
                "info": {
                    "label": {
                        "value": "Log changes, merge silver, audit, control, clean staging"
                    },
                    "notes": {
                        "value": null
                    }
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "executable_during_suggest": {
                        "value": false
                    },
                    "maxRetryProp": {
                        "expression": false,
                        "value": 0
                    },
                    "retryIntervalProp": {
                        "expression": false,
                        "value": 1
                    },
                    "sessionParamsProp": {
                        "value": []
                    },
                    "sqlQueryManagement": {
                        "value": "Continue to execute queued queries when pipeline is stopped or if it fails"
                    },
                    "sqlStatements": {
                        "value": [
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"INSERT INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes (run_id, object_name, business_key, cpq_id, op, row_hash, payload, changed_at) SELECT s.run_id, s.object_name, s.business_key, s.cpq_id, CASE WHEN t.business_key IS NULL OR t.is_deleted THEN 'I' ELSE 'U' END, s.row_hash, s.payload, current_timestamp() FROM (SELECT * FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \" QUALIFY row_number() OVER (PARTITION BY business_key ORDER BY cpq_id DESC) = 1) s LEFT JOIN (SELECT * FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = \" + (lib.cfg.sqlStr(_objectName)) + \") t ON t.business_key = s.business_key WHERE t.business_key IS NULL OR t.is_deleted OR t.row_hash <> s.row_hash\""
                                }
                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"INSERT INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes (run_id, object_name, business_key, cpq_id, op, row_hash, payload, changed_at) SELECT \" + (lib.cfg.sqlStr(_runId)) + \", \" + (lib.cfg.sqlStr(_objectName)) + \", t.business_key, t.cpq_id, 'D', t.row_hash, t.payload, current_timestamp() FROM (SELECT * FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = \" + (lib.cfg.sqlStr(_objectName)) + \" AND NOT is_deleted) t LEFT ANTI JOIN (SELECT business_key FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \") s ON t.business_key = s.business_key WHERE \" + ($allow ? 'true' : 'false')"
                                }
                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"MERGE INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows t USING (SELECT * FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \" AND object_name = \" + (lib.cfg.sqlStr(_objectName)) + \") c ON t.object_name = c.object_name AND t.business_key = c.business_key WHEN MATCHED AND c.op = 'D' THEN UPDATE SET t.is_deleted = true, t.deleted_at = c.changed_at, t.last_changed_at = c.changed_at, t.last_run_id = c.run_id WHEN MATCHED THEN UPDATE SET t.cpq_id = c.cpq_id, t.row_hash = c.row_hash, t.payload = c.payload, t.is_deleted = false, t.deleted_at = NULL, t.last_changed_at = c.changed_at, t.last_run_id = c.run_id WHEN NOT MATCHED AND c.op <> 'D' THEN INSERT (object_name, business_key, cpq_id, row_hash, payload, is_deleted, deleted_at, first_seen_at, last_changed_at, last_run_id) VALUES (c.object_name, c.business_key, c.cpq_id, c.row_hash, c.payload, false, NULL, c.changed_at, c.changed_at, c.run_id)\""
                                }
                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"INSERT INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_audit (run_id, object_name, finished_at, status, expected_total, staged_rows, distinct_keys, inserted_rows, updated_rows, deleted_rows, would_delete, deletes_allowed, message) SELECT \" + (lib.cfg.sqlStr(_runId)) + \", \" + (lib.cfg.sqlStr(_objectName)) + \", current_timestamp(), \" + (lib.cfg.sqlStr($status)) + \", \" + ('' + $expected) + \", \" + ('' + $staged_rows) + \", \" + ('' + $distinct_keys) + \", count_if(op = 'I'), count_if(op = 'U'), count_if(op = 'D'), \" + ('' + $would_delete) + \", \" + ($allow ? 'true' : 'false') + \", \" + (lib.cfg.sqlStr($message)) + \" FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes WHERE run_id = \" + (lib.cfg.sqlStr(_runId)) + \" AND object_name = \" + (lib.cfg.sqlStr(_objectName))"
                                }
                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"MERGE INTO \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_control t USING (SELECT \" + (lib.cfg.sqlStr(_objectName)) + \" AS object_name) s ON t.object_name = s.object_name WHEN MATCHED THEN UPDATE SET t.last_run_id = \" + (lib.cfg.sqlStr(_runId)) + \", t.last_run_at = current_timestamp(), t.last_status = \" + (lib.cfg.sqlStr($status)) + \", t.last_message = \" + (lib.cfg.sqlStr($message)) + \" WHEN NOT MATCHED THEN INSERT (object_name, last_run_id, last_run_at, last_status, last_message, watermark) VALUES (\" + (lib.cfg.sqlStr(_objectName)) + \", \" + (lib.cfg.sqlStr(_runId)) + \", current_timestamp(), \" + (lib.cfg.sqlStr($status)) + \", \" + (lib.cfg.sqlStr($message)) + \", NULL)\""
                                }
                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"DELETE FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE object_name = \" + (lib.cfg.sqlStr(_objectName))"
                                }
                            }
                        ]
                    }
                }
            }
        },
