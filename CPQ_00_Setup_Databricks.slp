            "class_id": "com-snaplogic-snaps-databricks-multiexecute",
            "class_version": 1,
            "instance_id": "11111111-1111-1111-1111-000000000001",
            "property_map": {
                "account": {
                    "account_ref": {
                        "value": {
                            "label": {
                                "expression": false,
                                "label": "../../shared/Databricks_EMEA-SE_sql-warehouse-SERVERLESS",
