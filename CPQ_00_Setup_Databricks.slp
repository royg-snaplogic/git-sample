                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "executable_during_suggest": {
                        "value": false
                    },
                    "maxRetryProp": {
                        "expression": false,
                        "value": 0
                    },
                    "passThrough": {
                        "value": true
                    },
                    "queryType": {
                        "expression": false,
                        "value": "Read"
                    },
                    "retryIntervalProp": {
                        "expression": false,
                        "value": 1
                    },
                    "sessionParamsProp": {
                        "value": []
                    },
                    "sqlQueryManagement": {
                        "value": "Continue to execute queued queries when pipeline is stopped or if it fails"
                    },
                    "sqlStatement": {
                        "expression": true,
                        "value": "\"SELECT current_catalog() AS current_catalog, current_user() AS run_as, (SELECT count(*) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows) AS silver_rows, (SELECT count(*) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_control) AS control_rows, (SELECT count(*) FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_audit) AS audit_rows\""
                    }
                }
            }
        }
