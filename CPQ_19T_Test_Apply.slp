                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"DELETE FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_audit WHERE object_name = \" + (\"'TEST_SNAPSHOT'\")"
