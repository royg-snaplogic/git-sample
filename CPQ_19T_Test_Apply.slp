                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"DELETE FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.sync_control WHERE object_name = \" + (\"'TEST_SNAPSHOT'\")"
                                }
                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"DELETE FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_ops.stg_snapshot WHERE object_name = \" + (\"'TEST_SNAPSHOT'\")"
