                            },
                            {
                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"DELETE FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_raw.snapshot_changes WHERE object_name = \" + (\"'TEST_SNAPSHOT'\")"
