                                "sqlStatement": {
                                    "expression": true,
                                    "value": "\"DELETE FROM \" + (lib.cfg.prefix(lib.cfg.catalog)) + \"cpq_silver.snapshot_rows WHERE object_name = \" + (\"'TEST_SNAPSHOT'\")"
